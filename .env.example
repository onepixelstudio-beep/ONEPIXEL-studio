# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# ==========================================
# ONEPIXEL STUDIO — CONFIGURACIÓN DE SOPORTE POR CORREO (GMAIL)
# ==========================================
# Correo de destino oficial donde se reciben los reportes:
SUPPORT_EMAIL_DESTINATION=ONEPIXELSTUDIO.SOPORTE@gmail.com

# Credenciales de Google App Password para envío real por Nodemailer:
# Configurar en Settings / Variables de entorno del servidor
GMAIL_USER=ONEPIXELSTUDIO.SOPORTE@gmail.com
GMAIL_APP_PASSWORD=

# Configuración SMTP alternativa (opcional):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
